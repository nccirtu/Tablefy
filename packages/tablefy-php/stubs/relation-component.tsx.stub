// Relation-Manager: {{ relation }} von {{ resourceSingular }} — Create/Edit/Delete als Modals.
// CRUD läuft über die Beziehung (der FK wird serverseitig gesetzt). Frei editierbar.

import { router } from "@inertiajs/react";
import {
  ActionsColumn,
  BadgeColumn,
  Button,
  DataTable,
  DateColumn,
  EnumColumn,
  NumberColumn,
  Section,
  TableSchema,
  TablefySchema,
  TextColumn,
  dialog,
} from "@nccirtu/tablefy-v2";
import {
  FormSchema,
  TextInput,
  Textarea,
  Select,
  Toggle,
  DatePicker,
} from "@nccirtu/tablefy-v2/forms";
import type { {{ relatedType }} } from "@/types/tablefy/{{ relatedKebab }}";
import {{ resourceSingular }}Controller from "@/actions/App/Http/Controllers/Tablefy/{{ resourceSingular }}Controller";

const {{ formConst }} = FormSchema.make<{{ relatedType }}>()
  .columns(2)
  .fields(
{{ formFields }}
  )
  .build();

export function {{ componentName }}({
  parentId,
  {{ relation }},
}: {
  parentId: number | string;
  {{ relation }}: {{ relatedType }}[];
}) {
  // Über Wayfinder, damit die URLs jedes Route-Präfix (z. B. den Standort)
  // mittragen — und beim Aufruf gebaut werden, nicht beim Import.
  const storeUrl = () =>
    {{ resourceSingular }}Controller.relationStore.url({ parentId, relation: "{{ relation }}" });
  const updateUrl = (relatedId: number | string) =>
    {{ resourceSingular }}Controller.relationUpdate.url({ parentId, relation: "{{ relation }}", relatedId });
  const destroyUrl = (relatedId: number | string) =>
    {{ resourceSingular }}Controller.relationDestroy.url({ parentId, relation: "{{ relation }}", relatedId });

  const reload = () => router.reload({ only: ["{{ relation }}"] });

  const table = TableSchema.make<{{ relatedType }}>()
    .searchable()
    .sortable()
    .columns(
{{ tableColumns }}
      ActionsColumn.make<{{ relatedType }}>()
        .action({
          label: "Bearbeiten",
          icon: "pencil",
          form: {
            schema: {{ formConst }},
            method: "put",
            url: (r) => updateUrl(r.id),
            data: (r) => r,
            onSuccess: reload,
          },
        })
        .delete((r) =>
          router.delete(destroyUrl(r.id), { preserveScroll: true, onSuccess: reload }),
        ),
    )
    .build();

  return (
    <TablefySchema
      schema={[
        Section.make("{{ relationStudly }}").schema([
          <div className="flex justify-end">
            <Button
              size="sm"
              onClick={() =>
                dialog.form({
                  title: "Neu",
                  schema: {{ formConst }},
                  url: storeUrl(),
                  method: "post",
                  onSuccess: reload,
                })
              }
            >
              Neu
            </Button>
          </div>,
          <DataTable schema={table} data={ {{ relation }} } />,
        ]),
      ]}
    />
  );
}
