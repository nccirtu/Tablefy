{
  "name": "@nccirtu/tablefy",
  "version": "0.9.3",
  "description": "A schema-driven toolkit for React tables and forms, built with TanStack Table and shadcn/ui. Designed for Laravel + Inertia.js v2 + Wayfinder.",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "tablefy": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "npm run build:lib && npm run build:fix-dts && npm run build:cli",
    "build:lib": "rollup -c",
    "build:fix-dts": "node scripts/fix-dts.js",
    "build:cli": "tsup cli/index.ts --outDir dist/cli --format esm --target node18",
    "dev": "rollup -c -w",
    "test": "jest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react",
    "table",
    "data-table",
    "forms",
    "schema-driven",
    "shadcn-ui",
    "tanstack-table",
    "typescript",
    "react-table",
    "data-grid",
    "ui-components",
    "tailwind",
    "inertia",
    "laravel",
    "wayfinder"
  ],
  "author": "Cirtu Cristian",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nccirtu/Tablefy.git",
    "directory": "packages/tablefy"
  },
  "bugs": {
    "url": "https://github.com/nccirtu/Tablefy/issues"
  },
  "homepage": "https://github.com/nccirtu/Tablefy#readme",
  "files": [
    "dist",
    "cli/templates",
    "styles.css",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@inertiajs/react": "^3.0.0",
    "@tanstack/react-table": "^8.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "zod": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-table": {
      "optional": false
    },
    "@inertiajs/react": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.16",
    "@radix-ui/react-checkbox": "^1.3.4",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-label": "^2.1.9",
    "@radix-ui/react-popover": "^1.1.16",
    "@radix-ui/react-progress": "^1.1.9",
    "@radix-ui/react-radio-group": "^1.4.0",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-separator": "^1.1.10",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-switch": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.14",
    "@radix-ui/react-tooltip": "^1.2.9",
    "chalk": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "commander": "^12.0.0",
    "date-fns": "^4.4.0",
    "fs-extra": "^11.2.0",
    "lucide-react": ">=0.300.0",
    "prompts": "^2.4.2",
    "react-day-picker": "^10.0.1",
    "recharts": "^3.8.1",
    "tailwind-merge": "^2.6.0",
    "tslib": "^2.5.0"
  },
  "devDependencies": {
    "@rollup/plugin-alias": "^5.1.0",
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.11.0",
    "@types/prompts": "^2.4.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^30.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rollup": "^3.20.0",
    "ts-jest": "^29.1.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    },
    "./columns": {
      "types": "./dist/columns/index.d.ts",
      "import": "./dist/columns/index.esm.js",
      "require": "./dist/columns/index.js"
    },
    "./forms": {
      "types": "./dist/forms/index.d.ts",
      "import": "./dist/forms/index.esm.js",
      "require": "./dist/forms/index.js"
    },
    "./kanban": {
      "types": "./dist/kanban/index.d.ts",
      "import": "./dist/kanban/index.esm.js",
      "require": "./dist/kanban/index.js"
    },
    "./charts": {
      "types": "./dist/charts/index.d.ts",
      "import": "./dist/charts/index.esm.js",
      "require": "./dist/charts/index.js"
    },
    "./inertia": {
      "types": "./dist/inertia/index.d.ts",
      "import": "./dist/inertia/index.esm.js",
      "require": "./dist/inertia/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "typesVersions": {
    "*": {
      "columns": [
        "dist/columns/index.d.ts"
      ],
      "forms": [
        "dist/forms/index.d.ts"
      ],
      "kanban": [
        "dist/kanban/index.d.ts"
      ],
      "charts": [
        "dist/charts/index.d.ts"
      ],
      "inertia": [
        "dist/inertia/index.d.ts"
      ]
    }
  }
}
